{
  "name": "hyperion-explorer",
  "version": "1.4.1",
  "description": "Official Lightweight Explorer for Hyperion History APIs",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4210",
    "start:ssl": "ng serve --host 0.0.0.0 --ssl",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "watch:prod": "ng build --watch --configuration production",
    "test": "ng test --watch=false",
    "serve:ssr:hyperion-explorer": "node dist/hyperion-explorer/server/server.mjs",
    "serve:ssr:watch": "node --watch dist/hyperion-explorer/server/server.mjs",
    "test:watch": "ng test --watch",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:mock": "node --test e2e/mock-api.spec.mjs",
    "build:mock": "ng build --output-path dist/mock",
    "mock": "bun run build:mock && node e2e/local-preview.mjs",
    "mock:serve": "node e2e/local-preview.mjs"
  },
  "private": true,
  "packageManager": "bun@1.4.4",
  "overrides": {
    "vite": "8.3.3"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.3",
    "@eosrio/hyperion-stream-client": "4.0.0-rc.3",
    "@fastify/compress": "^9.2.2",
    "@fastify/static": "^10.1.6",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "echarts": "^6.1.0",
    "fastify": "^5.12.7",
    "motion": "^14.4.0",
    "ngx-echarts": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "socket.io": "4.8.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
